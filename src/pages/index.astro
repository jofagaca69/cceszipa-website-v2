---
import MainLayout from '@layouts/MainLayout.astro'
import Hero from '@components/pages/index/hero.astro'
import HeroVideo from '@components/pages/index/HeroVideo.astro'
import FeaturesSection from '@components/pages/index/FeaturesSection.astro'
import EducationalStagesSection from '@components/pages/index/EducationalStagesSection.astro'
import TestimonialsSection from '@components/pages/index/TestimonialsSection.astro'
import LocationSection from '@components/pages/index/LocationSection.astro'
import HomeFAQSection, { homeFaqs } from '@components/pages/index/HomeFAQSection.astro'
import CTASection from '@components/pages/index/CTASection.astro'

const currentYear = new Date().getFullYear()

const seo = {
  title: "",
  description: `Colegio campestre privado en Zipaquirá con preescolar y primaria. Grupos reducidos, entorno natural y formación en valores. ¡Inscripciones abiertas ${currentYear}! Llámanos: 310 211 9422.`,
  keywords: "colegio campestre Zipaquirá, colegio privado Zipaquirá, preescolar Zipaquirá, primaria Zipaquirá, Colegio Campestre Exploradores del Saber, colegios Zipaquirá Cundinamarca, matrícula colegio Zipaquirá, educación en naturaleza, colegio campestre Nemocón, grupos reducidos colegio",
  canonical: "https://colexploradoresdelsaber.com/",
  noindex: false,
  ogImage: "/og-image-home.png",
  jsonLd: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["EducationalOrganization", "School"],
        "@id": "https://colexploradoresdelsaber.com/#school",
        "name": "Colegio Campestre Exploradores del Saber",
        "alternateName": ["CCESZIPA", "Exploradores del Saber"],
        "url": "https://colexploradoresdelsaber.com/",
        "logo": "https://colexploradoresdelsaber.com/logo.png",
        "image": "https://colexploradoresdelsaber.com/og-image-home.png",
        "description": "Colegio campestre privado en Zipaquirá, Cundinamarca. Ofrecemos preescolar (Prejardín, Jardín, Transición) y básica primaria (1° a 5°) con grupos reducidos, enfoque en valores y aprendizaje en contacto con la naturaleza.",
        "telephone": "+57-310-211-9422",
        "email": "rectoria@colexploradoresdelsaber.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Km. 5 vía Zipaquirá - Nemocón, Vereda La Granja",
          "addressLocality": "Zipaquirá",
          "addressRegion": "Cundinamarca",
          "postalCode": "250251",
          "addressCountry": "CO"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "5.0354775",
          "longitude": "-73.9648233"
        },
        "hasMap": "https://maps.app.goo.gl/3YkqKFrv2nAttDM67",
        "openingHours": ["Mo-Fr 06:30-14:30"],
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "06:30",
          "closes": "14:30"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+57-310-211-9422",
            "contactType": "admissions",
            "email": "rectoria@colexploradoresdelsaber.com",
            "availableLanguage": "Spanish",
            "areaServed": "CO"
          }
        ],
        "sameAs": [
          "https://www.facebook.com/ColegioCampestreExploradoresDelSaberZipaquira",
          "https://www.instagram.com/cceszipa"
        ],
        "areaServed": [
          { "@type": "City", "name": "Zipaquirá" },
          { "@type": "City", "name": "Nemocón" }
        ],
        "educationalCredentialAwarded": "Básica Primaria Colombiana",
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Oferta Académica",
          "url": "https://colexploradoresdelsaber.com/cursos",
          "itemListElement": [
            { "@type": "OfferCatalog", "name": "Preescolar (Prejardín, Jardín, Transición)" },
            { "@type": "OfferCatalog", "name": "Básica Primaria (1° a 5°)" }
          ]
        },
        "amenityFeature": [
          { "@type": "LocationFeatureSpecification", "name": "Huerta escolar", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Canchas deportivas", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Zonas verdes y senderos naturales", "value": true },
          { "@type": "LocationFeatureSpecification", "name": "Grupos reducidos", "value": true }
        ],
        "knowsAbout": [
          "Educación campestre",
          "Aprendizaje basado en la naturaleza",
          "Formación en valores",
          "Educación ambiental",
          "Pensamiento crítico infantil"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://colexploradoresdelsaber.com/#website",
        "name": "Colegio Campestre Exploradores del Saber",
        "url": "https://colexploradoresdelsaber.com/",
        "inLanguage": "es-CO",
        "publisher": {
          "@id": "https://colexploradoresdelsaber.com/#school"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "https://colexploradoresdelsaber.com/#faq",
        "mainEntity": homeFaqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer,
          },
        })),
      }
    ]
  }
}
---

<MainLayout {seo}>
  <Hero/>
  <HeroVideo/>
  <FeaturesSection/>
  <EducationalStagesSection/>
  <TestimonialsSection/>
  <LocationSection/>
  <HomeFAQSection />
  <CTASection/>
</MainLayout>