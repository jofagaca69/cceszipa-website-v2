---
import MainLayout from '@layouts/MainLayout.astro'
import ConocenosHero from '@components/pages/conocenos/hero.astro'
import History from '@components/pages/conocenos/history.astro'
import MissionVision from '@components/pages/conocenos/mission-vision.astro'
import ValuesSection from '@components/pages/conocenos/ValuesSection.astro'
import ManualConvivencia from '@components/pages/conocenos/ManualConvivencia.astro'
import CTASection from '@components/pages/conocenos/CTASection.astro'
import { institution } from '@config/institution'

const seo = {
  title: "Misión, Visión y Valores del Colegio Campestre Zipaquirá",
  description:
    "Conoce la historia, misión, visión y valores del Colegio Campestre Exploradores del Saber en Zipaquirá. Un proyecto educativo que une la excelencia académica con el amor por la naturaleza y los valores humanos.",
  keywords:
    "misión visión valores colegio Zipaquirá, historia Colegio Campestre Exploradores del Saber, filosofía educativa campestre, colegio privado valores Zipaquirá, proyecto educativo Zipaquirá, equipo docente colegio campestre, educación integral naturaleza Cundinamarca",
  canonical: "https://colexploradoresdelsaber.com/conocenos",
  noindex: false,
  ogImage: "/og-image-home.png",
  ogType: "website",
  jsonLd: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://colexploradoresdelsaber.com/conocenos#webpage",
        "url": "https://colexploradoresdelsaber.com/conocenos",
        "name": "Misión, Visión y Valores | Colegio Campestre Exploradores del Saber Zipaquirá",
        "description":
          "Conoce la historia, misión, visión y valores del Colegio Campestre Exploradores del Saber. Un proyecto educativo que une la excelencia académica con el amor por la naturaleza en Zipaquirá, Cundinamarca.",
        "isPartOf": {
          "@id": "https://colexploradoresdelsaber.com/#website"
        },
        "about": {
          "@type": "EducationalOrganization",
          "@id": "https://colexploradoresdelsaber.com/#school",
          "name": institution.name,
          "url": "https://colexploradoresdelsaber.com/"
        },
        "inLanguage": "es-CO"
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://colexploradoresdelsaber.com/conocenos#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://colexploradoresdelsaber.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Quiénes Somos",
            "item": "https://colexploradoresdelsaber.com/conocenos"
          }
        ]
      }
    ]
  }
}
---

<MainLayout {seo}>
  <ConocenosHero />
  <History headingLevel={2} />
  <MissionVision />
  <ValuesSection />
  <ManualConvivencia />
  <CTASection />
</MainLayout>
