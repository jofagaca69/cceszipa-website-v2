---
import MainLayout from '@layouts/MainLayout.astro'
import { Icon } from 'astro-icon/components'
import { institution } from '@config/institution'

const currentYear = new Date().getFullYear()
const waMessage = encodeURIComponent(`Hola, me gustaría recibir información sobre el colegio y el proceso de admisiones ${currentYear}.`)

const seo = {
  title: "Página no encontrada",
  description: "La página que buscas no existe. Regresa al inicio del Colegio Campestre Exploradores del Saber en Zipaquirá.",
  canonical: "https://colexploradoresdelsaber.com/404",
  noindex: true,
}
---

<MainLayout {seo}>
  <section
    class="relative flex flex-col items-center justify-center min-h-[82vh] pt-20 pb-16 px-4 text-center"
    aria-labelledby="notfound-heading"
    id="notfound-section"
  >

    <!-- Número 404 — hero visual principal: tres cajas naranjas -->
    <div class="notfound-number relative z-10 mb-6 opacity-0">
      <div class="inline-flex items-center gap-2 sm:gap-3">

        <div class="bg-ccesz-header rounded-2xl sm:rounded-3xl px-5 sm:px-7 py-4 sm:py-5 shadow-lg">
          <span class="block text-6xl sm:text-8xl md:text-9xl font-black text-[#fff7e8] leading-none">4</span>
        </div>

        <div class="bg-ccesz-header rounded-2xl sm:rounded-3xl px-5 sm:px-7 py-4 sm:py-5 shadow-lg">
          <span class="block text-6xl sm:text-8xl md:text-9xl font-black text-[#fff7e8] leading-none">0</span>
        </div>

        <div class="bg-ccesz-header rounded-2xl sm:rounded-3xl px-5 sm:px-7 py-4 sm:py-5 shadow-lg">
          <span class="block text-6xl sm:text-8xl md:text-9xl font-black text-[#fff7e8] leading-none">4</span>
        </div>

      </div>
    </div>

    <!-- Texto principal -->
    <div class="notfound-content relative z-10 max-w-lg mx-auto opacity-0">
      <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-orange-600/70 mb-3">
        Página no encontrada
      </p>
      <h1
        id="notfound-heading"
        class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-4"
      >
        ¡Esta página se perdió explorando!
      </h1>
      <p class="text-base sm:text-lg text-gray-500 leading-relaxed">
        La ruta que buscas no existe o fue movida a otro sendero.
        No te pierdas — te llevamos de vuelta al camino.
      </p>
    </div>

    <!-- Ilustración de árboles -->
    <div class="notfound-trees relative z-10 mt-8 mb-4 opacity-0 w-full max-w-2xl" aria-hidden="true">
      <svg viewBox="0 0 600 140" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <ellipse cx="300" cy="132" rx="280" ry="10" fill="#f86c05" opacity="0.15"/>
        <rect x="50" y="95" width="6" height="32" rx="3" fill="#7c3e02"/>
        <polygon points="53,46 30,96 76,96" fill="#b45309" opacity="0.7"/>
        <polygon points="53,28 26,72 80,72" fill="#92400e" opacity="0.75"/>
        <rect x="128" y="84" width="8" height="44" rx="3" fill="#7c3e02"/>
        <polygon points="132,22 100,86 164,86" fill="#f86c05" opacity="0.45"/>
        <polygon points="132,6 96,62 168,62" fill="#ea580c" opacity="0.5"/>
        <polygon points="132,0 98,46 166,46" fill="#f97316" opacity="0.4"/>
        <rect x="218" y="90" width="7" height="38" rx="3" fill="#7c3e02"/>
        <polygon points="221,38 196,92 246,92" fill="#b45309" opacity="0.65"/>
        <polygon points="221,20 192,68 250,68" fill="#92400e" opacity="0.7"/>
        <rect x="288" y="90" width="4" height="36" rx="2" fill="#7c3e02" opacity="0.5"/>
        <circle cx="290" cy="80" r="12" fill="#f86c05" opacity="0.9"/>
        <text x="286" y="85" font-size="14" font-weight="900" fill="white" font-family="system-ui, sans-serif">?</text>
        <rect x="368" y="90" width="7" height="38" rx="3" fill="#7c3e02"/>
        <polygon points="371,38 346,92 396,92" fill="#f86c05" opacity="0.42"/>
        <polygon points="371,20 342,68 400,68" fill="#ea580c" opacity="0.48"/>
        <rect x="460" y="84" width="8" height="44" rx="3" fill="#7c3e02"/>
        <polygon points="464,22 432,86 496,86" fill="#f86c05" opacity="0.45"/>
        <polygon points="464,6 428,62 500,62" fill="#ea580c" opacity="0.5"/>
        <polygon points="464,0 430,46 498,46" fill="#f97316" opacity="0.4"/>
        <rect x="542" y="95" width="6" height="32" rx="3" fill="#7c3e02"/>
        <polygon points="545,46 522,96 568,96" fill="#b45309" opacity="0.7"/>
        <polygon points="545,28 518,72 572,72" fill="#92400e" opacity="0.75"/>
      </svg>
    </div>

    <!-- CTAs -->
    <div class="notfound-actions relative z-10 flex flex-col sm:flex-row justify-center items-center gap-3 opacity-0">
      <a
        href="/"
        title="Volver al inicio del Colegio Campestre Exploradores del Saber"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-gray-900 px-7 py-3.5 text-sm font-semibold text-white hover:bg-gray-700 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-400/50"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        Volver al inicio
      </a>
      <a
        href="/inscripciones"
        title="Ver el proceso de inscripciones"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-ccesz-header px-7 py-3.5 text-sm font-semibold text-white hover:opacity-90 transition-opacity duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-orange-400/50"
      >
        Ver inscripciones
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
      <a
        href={`https://wa.me/${institution.phone}?text=${waMessage}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Contactar por WhatsApp"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-green-600 px-7 py-3.5 text-sm font-semibold text-white hover:bg-green-500 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-green-400/50"
      >
        <Icon name="mdi:whatsapp" class="w-4 h-4" />
        WhatsApp
      </a>
    </div>

    <!-- Quick links -->
    <div class="notfound-links relative z-10 mt-8 opacity-0">
      <p class="text-xs font-bold tracking-[0.15em] uppercase text-gray-400 mb-3">O explora el sitio</p>
      <nav class="flex flex-wrap justify-center gap-2" aria-label="Páginas principales del sitio">
        <a href="/conocenos" title="Ir a Conócenos" class="text-sm font-medium text-gray-600 hover:text-ccesz-header transition-colors px-4 py-2 rounded-full bg-white border border-gray-200 hover:border-ccesz-header/40">Conócenos</a>
        <a href="/cursos" title="Ir a Preescolar y Primaria" class="text-sm font-medium text-gray-600 hover:text-ccesz-header transition-colors px-4 py-2 rounded-full bg-white border border-gray-200 hover:border-ccesz-header/40">Preescolar y Primaria</a>
        <a href="/galeria" title="Ir a la Galería" class="text-sm font-medium text-gray-600 hover:text-ccesz-header transition-colors px-4 py-2 rounded-full bg-white border border-gray-200 hover:border-ccesz-header/40">Galería</a>
        <a href="/inscripciones" title="Ir a Inscripciones" class="text-sm font-medium text-gray-600 hover:text-ccesz-header transition-colors px-4 py-2 rounded-full bg-white border border-gray-200 hover:border-ccesz-header/40">Inscripciones</a>
      </nav>
    </div>

  </section>
</MainLayout>

<script>
  import { gsap } from "gsap"

  const tl = gsap.timeline({ defaults: { ease: "power3.out" } })

  tl.fromTo(".notfound-number",  { opacity: 0, y: -30 }, { opacity: 1, y: 0, duration: 0.9, delay: 0.1 })
    .fromTo(".notfound-content", { opacity: 0, y: 20  }, { opacity: 1, y: 0, duration: 0.8 }, "-=0.4")
    .fromTo(".notfound-trees",   { opacity: 0, y: 16  }, { opacity: 1, y: 0, duration: 0.7 }, "-=0.3")
    .fromTo(".notfound-actions", { opacity: 0, y: 16  }, { opacity: 1, y: 0, duration: 0.7 }, "-=0.3")
    .fromTo(".notfound-links",   { opacity: 0, y: 12  }, { opacity: 1, y: 0, duration: 0.6 }, "-=0.3")

  gsap.to(".notfound-number", {
    y: -8,
    duration: 3.2,
    ease: "sine.inOut",
    yoyo: true,
    repeat: -1,
    delay: 1.2
  })
</script>