---
import MainLayout from '@layouts/MainLayout.astro'
import GalleryHero from '@components/pages/galeria/GalleryHero.astro'
import GallerySection from '@components/pages/galeria/GallerySection.astro'
import CTASection from '@components/pages/cursos/CTASection.astro'
import { institution } from '@config/institution'

const seo = {
  title: "Galería de Actividades",
  description:
    "Fotos de las actividades del Colegio Campestre Exploradores del Saber en Zipaquirá: deportes, arte, cultura, eventos y celebraciones. Conoce cómo es la vida diaria en nuestro entorno campestre.",
  keywords:
    "galería fotos colegio campestre Zipaquirá, actividades escolares colegio Zipaquirá, deportes arte eventos colegio, vida escolar campestre Cundinamarca, fotos colegio privado Zipaquirá, Exploradores del Saber actividades",
  canonical: "https://colexploradoresdelsaber.com/galeria",
  noindex: false,
  ogImage: "/og-image-home.png",
  ogType: "website",
  jsonLd: {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://colexploradoresdelsaber.com/galeria#webpage",
        "url": "https://colexploradoresdelsaber.com/galeria",
        "name": "Galería de Actividades | Colegio Campestre Exploradores del Saber",
        "description":
          "Descubre los mejores momentos del Colegio Campestre Exploradores del Saber: actividades deportivas, artísticas, culturales y eventos de nuestra comunidad.",
        "isPartOf": {
          "@id": "https://colexploradoresdelsaber.com/#website"
        },
        "about": {
          "@type": "EducationalOrganization",
          "@id": "https://colexploradoresdelsaber.com/#school",
          "name": institution.name,
          "url": "https://colexploradoresdelsaber.com/"
        },
        "inLanguage": "es-CO"
      },
      {
        "@type": "ImageGallery",
        "@id": "https://colexploradoresdelsaber.com/galeria#gallery",
        "name": "Galería de Actividades – Colegio Campestre Exploradores del Saber",
        "description": "Fotos de actividades deportivas, artísticas, culturales y eventos del Colegio Campestre Exploradores del Saber en Zipaquirá.",
        "url": "https://colexploradoresdelsaber.com/galeria",
        "isPartOf": { "@id": "https://colexploradoresdelsaber.com/#website" },
        "associatedMedia": [
          { "@type": "ImageObject", "name": "Torneo interno de fútbol", "description": "Niños jugando fútbol en la cancha del colegio campestre" },
          { "@type": "ImageObject", "name": "Actividades deportivas al aire libre", "description": "Día de campo y actividades físicas en entorno natural" },
          { "@type": "ImageObject", "name": "Festival cultural", "description": "Presentaciones artísticas de estudiantes del colegio" },
          { "@type": "ImageObject", "name": "Taller de manualidades", "description": "Actividades de expresión plástica y creatividad" },
          { "@type": "ImageObject", "name": "Izada de bandera", "description": "Ceremonia institucional de valores y respeto" },
          { "@type": "ImageObject", "name": "Día de la familia", "description": "Convivencia en comunidad educativa campestre" }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "@id": "https://colexploradoresdelsaber.com/galeria#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://colexploradoresdelsaber.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Galería",
            "item": "https://colexploradoresdelsaber.com/galeria"
          }
        ]
      }
    ]
  }
}
---

<MainLayout {seo}>
  <GalleryHero />
  <GallerySection />
  <CTASection />
</MainLayout>
