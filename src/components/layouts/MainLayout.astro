---
import BaseSEO from '@components/SEO/BaseSEO.astro'
import Header from '@components/UI/header.astro'
import Footer from '@components/UI/footer.astro'
import "../../styles/global.css";
import Preheader from '@components/UI/pre-header.astro'
import type { Props as SeoProps } from "@components/SEO/BaseSEO.astro";

export interface Props {
  seo: SeoProps
}
const { seo } = Astro.props
---

<!DOCTYPE html>
<html lang="es-CO">
<head>
  <BaseSEO {...seo} />
</head>

<body class="bg-[#fff7e8] text-gray-800 min-h-screen flex flex-col overflow-x-hidden">
  <div class="sticky top-0 z-50">
    <Preheader/>
    <Header/>
  </div>
  <main id="main-content" class="flex-1 w-full max-w-[1600px] mx-auto">
    <slot />
  </main>
  <Footer />
</body>
</html>