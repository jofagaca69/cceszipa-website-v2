---
import { Icon } from "astro-icon/components"

const preescolarLevels = [
  { nombre: "Prejardín",  rango: "3 – 4 años", icon: "mdi:emoticon-happy-outline", href: "#preescolar-section" },
  { nombre: "Jardín",     rango: "4 – 5 años", icon: "mdi:flower-outline",          href: "#preescolar-section" },
  { nombre: "Transición", rango: "5 – 6 años", icon: "mdi:star-outline",            href: "#preescolar-section" },
] as const

const primariaLevels = [
  { nombre: "Primero",  rango: "6 – 7 años",   icon: "mdi:numeric-1-circle-outline", href: "#primaria-section" },
  { nombre: "Segundo",  rango: "7 – 8 años",   icon: "mdi:numeric-2-circle-outline", href: "#primaria-section" },
  { nombre: "Tercero",  rango: "8 – 9 años",   icon: "mdi:numeric-3-circle-outline", href: "#primaria-section" },
  { nombre: "Cuarto",   rango: "9 – 10 años",  icon: "mdi:numeric-4-circle-outline", href: "#primaria-section" },
  { nombre: "Quinto",   rango: "10 – 11 años", icon: "mdi:numeric-5-circle-outline", href: "#primaria-section" },
] as const

const allLevels = [
  ...preescolarLevels.map(l => ({ ...l, group: "preescolar" as const })),
  ...primariaLevels.map(l => ({ ...l, group: "primaria" as const })),
]
---

<section
  id="journey-section"
  class="py-16 md:py-20 bg-[#FFF7E8]"
  aria-labelledby="journey-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-10 md:mb-12">
      <p class="journey-eyebrow opacity-0 text-xs font-bold tracking-[0.2em] uppercase text-orange-600/70 mb-3">
        Ruta académica
      </p>
      <h2
        id="journey-heading"
        class="journey-title opacity-0 text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 tracking-tight"
      >
        De Prejardín hasta Quinto Grado
      </h2>
      <p class="journey-sub opacity-0 mt-3 text-base text-gray-500 max-w-lg mx-auto leading-relaxed">
        Ocho niveles pensados para cada etapa del desarrollo de tu hijo, en un entorno que inspira el aprendizaje.
      </p>
    </div>

    <!-- ───────────────────────────────────────────────
         MOBILE layout (< lg): dos tarjetas de grupo
         ─────────────────────────────────────────────── -->
    <div class="lg:hidden flex flex-col gap-4">

      <!-- Preescolar card -->
      <div class="journey-mobile-card opacity-0 bg-orange-50 border border-orange-100 rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-5">
          <span class="w-2 h-2 rounded-full bg-orange-500" aria-hidden="true"></span>
          <span class="text-xs font-bold text-orange-600 uppercase tracking-wider">Preescolar</span>
          <span class="text-[10px] text-orange-400/80 ml-auto">3 – 6 años</span>
        </div>
        <!-- Mini-timeline: 3 nodos con justify-around -->
        <div class="relative">
          <!-- Track -->
          <div class="absolute h-px bg-orange-200" style="top: 20px; left: 16.7%; right: 16.7%;" aria-hidden="true"></div>
          <!-- Fill animado -->
          <div class="mobile-line-pre absolute h-0.5 bg-orange-400 origin-left" style="top: 19.5px; left: 16.7%; right: 16.7%;" aria-hidden="true"></div>
          <div class="flex justify-around relative">
            {preescolarLevels.map(level => (
              <a
                href={level.href}
                class="mobile-node-pre opacity-0 flex flex-col items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 rounded-xl px-1"
              >
                <div class="mobile-circle w-10 h-10 rounded-full border-2 border-orange-400 bg-white flex items-center justify-center will-change-transform">
                  <Icon name={level.icon} class="w-[18px] h-[18px] text-orange-500" aria-hidden="true" />
                </div>
                <span class="text-[11px] font-bold text-orange-700 text-center leading-tight">{level.nombre}</span>
                <span class="text-[9px] text-gray-400 text-center leading-tight">{level.rango}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Primaria card -->
      <div class="journey-mobile-card opacity-0 bg-amber-50 border border-amber-100 rounded-2xl p-5">
        <div class="flex items-center gap-2 mb-5">
          <span class="w-2 h-2 rounded-full bg-[#873701]" aria-hidden="true"></span>
          <span class="text-xs font-bold text-[#873701] uppercase tracking-wider">Básica Primaria</span>
          <span class="text-[10px] text-[#873701]/60 ml-auto">6 – 11 años</span>
        </div>
        <!-- Mini-timeline: 5 nodos con justify-around -->
        <div class="relative">
          <!-- Track -->
          <div class="absolute h-px bg-amber-200" style="top: 20px; left: 10%; right: 10%;" aria-hidden="true"></div>
          <!-- Fill animado -->
          <div class="mobile-line-prim absolute h-0.5 bg-[#873701] origin-left" style="top: 19.5px; left: 10%; right: 10%;" aria-hidden="true"></div>
          <div class="flex justify-around relative">
            {primariaLevels.map(level => (
              <a
                href={level.href}
                class="mobile-node-prim opacity-0 flex flex-col items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-xl px-1"
              >
                <div class="mobile-circle w-10 h-10 rounded-full border-2 border-[#873701] bg-white flex items-center justify-center will-change-transform">
                  <Icon name={level.icon} class="w-[18px] h-[18px] text-[#873701]" aria-hidden="true" />
                </div>
                <span class="text-[11px] font-bold text-[#873701] text-center leading-tight">{level.nombre}</span>
                <span class="text-[9px] text-gray-400 text-center leading-tight">{level.rango}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- ───────────────────────────────────────────────
         DESKTOP layout (lg+): timeline horizontal completo
         ─────────────────────────────────────────────── -->
    <div class="hidden lg:block">

      <!-- Barras de grupo -->
      <div class="journey-labels opacity-0 flex gap-3 mb-5">
        <div class="flex-[3] bg-orange-50 border border-orange-200 rounded-xl py-2.5 text-center">
          <span class="text-xs font-bold text-orange-600 uppercase tracking-wider">Preescolar</span>
          <span class="text-[10px] text-orange-400/80 block mt-0.5">3 – 6 años</span>
        </div>
        <div class="flex-[5] bg-amber-50 border border-amber-200 rounded-xl py-2.5 text-center">
          <span class="text-xs font-bold text-[#873701] uppercase tracking-wider">Básica Primaria</span>
          <span class="text-[10px] text-[#873701]/60 block mt-0.5">6 – 11 años</span>
        </div>
      </div>

      <!-- Línea + nodos -->
      <div class="relative">
        <!-- Track -->
        <div
          class="absolute h-px bg-gray-200 z-0"
          style="top: 28px; left: calc(100% / 16); right: calc(100% / 16);"
          aria-hidden="true"
        ></div>
        <!-- Fill animado -->
        <div
          class="journey-line-fill absolute h-0.5 bg-gradient-to-r from-orange-400 to-[#873701] origin-left z-0"
          style="top: 27.5px; left: calc(100% / 16); right: calc(100% / 16);"
          aria-hidden="true"
        ></div>

        <!-- Grid de nodos -->
        <div class="grid grid-cols-8 gap-1 relative">
          {allLevels.map(level => (
            <a
              href={level.href}
              class="journey-node opacity-0 flex flex-col items-center gap-1.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-400 rounded-xl"
            >
              <div
                class={[
                  "journey-node-circle w-14 h-14 rounded-full border-2 flex items-center justify-center will-change-transform",
                  level.group === "preescolar"
                    ? "border-orange-400 bg-orange-50 text-orange-500"
                    : "border-[#873701] bg-amber-50 text-[#873701]",
                ].join(" ")}
              >
                <Icon name={level.icon} class="w-6 h-6" aria-hidden="true" />
              </div>
              <span class={[
                "text-[11px] font-bold text-center leading-tight",
                level.group === "preescolar" ? "text-orange-700" : "text-[#873701]",
              ].join(" ")}>
                {level.nombre}
              </span>
              <span class="text-[9px] text-gray-400 text-center leading-tight">
                {level.rango}
              </span>
            </a>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const st = {
    trigger: "#journey-section",
    start: "top 75%",
    toggleActions: "play none none none",
  }

  // Header — visible en ambos layouts
  gsap.fromTo(".journey-eyebrow", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", scrollTrigger: st })
  gsap.fromTo(".journey-title",   { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", delay: 0.08, scrollTrigger: st })
  gsap.fromTo(".journey-sub",     { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", delay: 0.16, scrollTrigger: st })

  const mm = gsap.matchMedia()

  // ── Mobile (< 1024px) ──────────────────────────────────
  mm.add("(max-width: 1023px)", () => {
    gsap.fromTo(".journey-mobile-card",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.15, ease: "power3.out", delay: 0.3, scrollTrigger: st }
    )

    // Línea Preescolar
    gsap.fromTo(".mobile-line-pre",
      { scaleX: 0 },
      { scaleX: 1, duration: 0.9, ease: "power2.inOut", delay: 0.55, scrollTrigger: st }
    )
    gsap.fromTo(".mobile-node-pre",
      { opacity: 0, scale: 0.3, y: 8 },
      { opacity: 1, scale: 1, y: 0, duration: 0.4, stagger: 0.1, ease: "back.out(1.8)", delay: 0.65, scrollTrigger: st }
    )

    // Línea Primaria
    gsap.fromTo(".mobile-line-prim",
      { scaleX: 0 },
      { scaleX: 1, duration: 1.1, ease: "power2.inOut", delay: 0.75, scrollTrigger: st }
    )
    gsap.fromTo(".mobile-node-prim",
      { opacity: 0, scale: 0.3, y: 8 },
      { opacity: 1, scale: 1, y: 0, duration: 0.4, stagger: 0.09, ease: "back.out(1.8)", delay: 0.85, scrollTrigger: st }
    )

    // Hover en mobile (touch devices no lo usan, pero tablets sí)
    document.querySelectorAll<HTMLElement>(".mobile-node-pre, .mobile-node-prim").forEach(node => {
      const circle = node.querySelector<HTMLElement>(".mobile-circle")
      if (!circle) return
      node.addEventListener("mouseenter", () => gsap.to(circle, { scale: 1.15, duration: 0.2, ease: "back.out(2)" }))
      node.addEventListener("mouseleave", () => gsap.to(circle, { scale: 1, duration: 0.25, ease: "power2.out" }))
    })
  })

  // ── Desktop (≥ 1024px) ────────────────────────────────
  mm.add("(min-width: 1024px)", () => {
    gsap.fromTo(".journey-labels",
      { opacity: 0, y: 12 },
      { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", delay: 0.3, scrollTrigger: st }
    )
    gsap.fromTo(".journey-line-fill",
      { scaleX: 0 },
      { scaleX: 1, duration: 1.4, ease: "power2.inOut", delay: 0.55, scrollTrigger: st }
    )
    gsap.fromTo(".journey-node",
      { opacity: 0, scale: 0.3, y: 10 },
      { opacity: 1, scale: 1, y: 0, duration: 0.45, stagger: 0.09, ease: "back.out(1.8)", delay: 0.65, scrollTrigger: st }
    )

    document.querySelectorAll<HTMLElement>(".journey-node").forEach(node => {
      const circle = node.querySelector<HTMLElement>(".journey-node-circle")
      if (!circle) return
      node.addEventListener("mouseenter", () => gsap.to(circle, { scale: 1.15, duration: 0.22, ease: "back.out(2)" }))
      node.addEventListener("mouseleave", () => gsap.to(circle, { scale: 1, duration: 0.28, ease: "power2.out" }))
    })
  })
</script>
