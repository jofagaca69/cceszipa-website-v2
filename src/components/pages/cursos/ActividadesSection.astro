---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import img2 from "../../../assets/hero2.webp"
import img3 from "../../../assets/hero3.webp"
import img4 from "../../../assets/hero4.webp"

const actividades = [
  {
    numero: "01",
    nombre: "Arte y Manualidades",
    icon: "mdi:palette-outline",
    nivel: "Todos los niveles",
    descripcion:
      "Pintamos, creamos y construimos. Cada proyecto artístico desarrolla la creatividad, la motricidad fina y la autoexpresión de nuestros estudiantes en un ambiente de libre exploración.",
    accent: "orange" as const,
    image: img3,
    imageAlt: "Niños en actividad de arte y manualidades en el colegio campestre",
  },
  {
    numero: "02",
    nombre: "Deporte y Recreación",
    icon: "mdi:run-fast",
    nivel: "Todos los niveles",
    descripcion:
      "Fútbol, atletismo y juegos en equipo en nuestros espacios al aire libre. El deporte fortalece la disciplina, la cooperación y el bienestar físico desde los primeros años.",
    accent: "brown" as const,
    image: img4,
    imageAlt: "Estudiantes en actividades deportivas al aire libre",
  },
  {
    numero: "03",
    nombre: "Música y Danza",
    icon: "mdi:music-note-outline",
    nivel: "Todos los niveles",
    descripcion:
      "Ritmo, melodía y movimiento. Los estudiantes aprenden a expresarse a través de la música y la danza, desarrollando sensibilidad artística, coordinación y trabajo en equipo.",
    accent: "orange" as const,
    image: img2,
    imageAlt: "Estudiantes en clase de música y danza",
  },
  {
    numero: "04",
    nombre: "Huerta Escolar",
    icon: "mdi:sprout-outline",
    nivel: "Desde Jardín",
    descripcion:
      "En nuestro huerto aprendemos sobre el ciclo de la vida, la responsabilidad ambiental y la alimentación saludable. La naturaleza se convierte en el aula de ciencias más auténtica.",
    accent: "brown" as const,
    image: img3,
    imageAlt: "Estudiantes trabajando en la huerta escolar campestre",
  },
  {
    numero: "05",
    nombre: "Exploración Natural",
    icon: "mdi:binoculars",
    nivel: "Todos los niveles",
    descripcion:
      "Caminatas guiadas, observación de fauna y flora, y experimentos al aire libre que aprovechan los 5 kilómetros de entorno campestre único de nuestra sede.",
    accent: "orange" as const,
    image: img4,
    imageAlt: "Estudiantes explorando la naturaleza en el entorno campestre",
  },
  {
    numero: "06",
    nombre: "Teatro y Expresión",
    icon: "mdi:account-voice",
    nivel: "Desde Transición",
    descripcion:
      "Dramatizaciones, cuentería y presentaciones que potencian la oralidad, la confianza en público y la creatividad. Cada estudiante encuentra su voz en el escenario.",
    accent: "brown" as const,
    image: img2,
    imageAlt: "Estudiantes en presentación de teatro escolar",
  },
]

const accentColor = {
  orange: { text: "text-[#f86c05]", bg: "bg-orange-50", tag: "bg-orange-50 text-[#f86c05]", line: "bg-[#f86c05]" },
  brown:  { text: "text-[#873701]", bg: "bg-amber-50",  tag: "bg-amber-50 text-[#873701]",  line: "bg-[#873701]" },
}
---

<section
  id="actividades-section"
  class="w-screen max-w-none relative left-1/2 -translate-x-1/2 bg-white py-16 md:py-24"
  aria-labelledby="actividades-heading"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Encabezado -->
    <div class="text-center mb-16 md:mb-20 max-w-2xl mx-auto">
      <p class="act-eyebrow opacity-0 text-xs font-bold tracking-[0.2em] uppercase text-orange-600/70 mb-4">
        Vida escolar
      </p>
      <h2
        id="actividades-heading"
        class="act-heading opacity-0 text-3xl sm:text-4xl md:text-[2.6rem] font-bold text-gray-900 tracking-tight leading-[1.1]"
      >
        Actividades lúdicas y culturales
      </h2>
      <p class="act-sub opacity-0 mt-4 text-base sm:text-lg text-gray-500 leading-relaxed">
        Más allá del aula, cada estudiante descubre sus talentos a través de experiencias que integran el cuerpo, las emociones y la creatividad.
      </p>
    </div>

    <!-- Filas en zigzag -->
    <div class="flex flex-col gap-16 md:gap-24">
      {actividades.map((act, index) => {
        const isEven = index % 2 === 1
        const s = accentColor[act.accent]
        return (
          <div
            class="act-row flex flex-col md:flex-row gap-10 md:gap-14 items-center"
            class:list={[{ "md:flex-row-reverse": isEven }]}
            data-dir={isEven ? "right" : "left"}
          >

            <!-- Imagen -->
            <div class="act-row-img w-full md:w-[45%] md:flex-shrink-0 opacity-0">
              <div class="relative rounded-2xl overflow-hidden aspect-[4/3]">
                <Image
                  src={act.image}
                  alt={act.imageAlt}
                  title={act.imageAlt}
                  width={640}
                  height={480}
                  format="webp"
                  quality={82}
                  class="act-img w-full h-full object-cover will-change-transform"
                />
                <!-- Degradado inferior -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent pointer-events-none" aria-hidden="true"></div>
                <!-- Icono badge sobre la imagen -->
                <div class={`absolute bottom-4 ${isEven ? "right-4" : "left-4"} w-11 h-11 rounded-xl ${s.bg} flex items-center justify-center shadow-md`}>
                  <Icon name={act.icon} class={`w-5 h-5 ${s.text}`} aria-hidden="true" />
                </div>
              </div>
            </div>

            <!-- Texto -->
            <div class="act-row-text w-full md:flex-1 flex flex-col gap-4 opacity-0">

              <!-- Número + nivel -->
              <div class="flex items-center gap-4">
                <span class={`text-4xl md:text-5xl font-black ${s.text} leading-none select-none tabular-nums`}>
                  {act.numero}
                </span>
                <span class={`text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full ${s.tag}`}>
                  {act.nivel}
                </span>
              </div>

              <!-- Línea de acento -->
              <div class={`w-10 h-0.5 ${s.line}`} aria-hidden="true"></div>

              <!-- Nombre -->
              <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-tight">
                {act.nombre}
              </h3>

              <!-- Descripción -->
              <p class="text-base text-gray-500 leading-relaxed max-w-prose">
                {act.descripcion}
              </p>

            </div>

          </div>
        )
      })}
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  // Encabezado
  const headTrigger = { trigger: "#actividades-section", start: "top 78%", toggleActions: "play none none none" }
  gsap.fromTo(".act-eyebrow", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", scrollTrigger: headTrigger })
  gsap.fromTo(".act-heading", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", delay: 0.08, scrollTrigger: headTrigger })
  gsap.fromTo(".act-sub",     { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", delay: 0.16, scrollTrigger: headTrigger })

  // Cada fila zigzag: imagen y texto entran desde lados opuestos
  document.querySelectorAll<HTMLElement>(".act-row").forEach(row => {
    const dir    = row.dataset.dir === "right" ? 1 : -1
    const img    = row.querySelector<HTMLElement>(".act-row-img")
    const text   = row.querySelector<HTMLElement>(".act-row-text")
    const imgEl  = row.querySelector<HTMLElement>(".act-img")

    const st = { trigger: row, start: "top 80%", toggleActions: "play none none none" }

    if (img)  gsap.fromTo(img,  { opacity: 0, x: dir * -40 }, { opacity: 1, x: 0, duration: 0.9, ease: "power3.out", scrollTrigger: st })
    if (text) gsap.fromTo(text, { opacity: 0, x: dir *  40 }, { opacity: 1, x: 0, duration: 0.9, ease: "power3.out", delay: 0.12, scrollTrigger: st })

    // Hover: zoom en la imagen
    if (img && imgEl) {
      img.addEventListener("mouseenter", () => gsap.to(imgEl, { scale: 1.05, duration: 0.5, ease: "power2.out" }))
      img.addEventListener("mouseleave", () => gsap.to(imgEl, { scale: 1,    duration: 0.5, ease: "power2.out" }))
    }
  })
</script>
