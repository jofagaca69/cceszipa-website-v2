---
const steps = [
  {
    number: "01",
    title: "Solicita información",
    description: "Contáctanos por WhatsApp o teléfono. Con gusto te contamos sobre nuestra propuesta educativa, niveles disponibles y costos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
  },
  {
    number: "02",
    title: "Visita el campus",
    description: "Te invitamos a conocer nuestras instalaciones, el entorno campestre y el ambiente de aprendizaje. Puedes traer a tu hijo para que lo viva desde el primer momento.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
  {
    number: "03",
    title: "Entrega de documentos",
    description: "Reúne los documentos requeridos: registro civil, carnet de vacunación, boletines del año anterior e informe psicomotriz (según el nivel). Te damos la lista completa.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>`,
  },
  {
    number: "04",
    title: "Aprobación y matrícula",
    description: "Una vez revisados los documentos, se confirma el cupo y se formaliza la matrícula. Te indicamos el valor y las formas de pago disponibles.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  },
  {
    number: "05",
    title: "¡Bienvenido a Exploradores!",
    description: "Tu hijo ya es parte de nuestra comunidad. Te compartimos el calendario escolar, el manual de convivencia y toda la información para comenzar con el pie derecho.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>`,
  },
]
---

<section
  class="py-16 md:py-24"
  aria-labelledby="proceso-heading"
  id="proceso-section"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="proceso-header text-center mb-14 opacity-0">
      <p class="text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-orange-600/70 mb-3">
        Paso a paso
      </p>
      <h2 id="proceso-heading" class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">
        Proceso de admisión
      </h2>
      <p class="mt-3 text-base sm:text-lg text-gray-500 max-w-xl mx-auto">
        Simple, transparente y acompañado en cada etapa.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Vertical line (desktop) -->
      <div class="hidden lg:block absolute left-1/2 -translate-x-px top-0 bottom-0 w-0.5 bg-orange-100" aria-hidden="true"></div>

      <div class="flex flex-col gap-10 lg:gap-0">
        {steps.map((step, i) => (
          <div class={`proceso-step proceso-step-${i} opacity-0 relative lg:flex lg:items-center lg:gap-0 ${i % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'}`}>

            <!-- Card -->
            <div class={`w-full lg:w-[calc(50%-2.5rem)] ${i % 2 === 0 ? 'lg:pr-10 lg:text-right' : 'lg:pl-10 lg:text-left'}`}>
              <div class="bg-white border border-gray-200 rounded-2xl p-6 md:p-7 hover:border-ccesz-header/40 hover:shadow-md transition-all duration-300">
                <div class={`flex items-center gap-3 mb-4 ${i % 2 === 0 ? 'lg:justify-end' : 'lg:justify-start'}`}>
                  <span class="text-3xl font-black text-orange-100 leading-none select-none">{step.number}</span>
                  <div class="w-10 h-10 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-ccesz-header" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <Fragment set:html={step.icon} />
                    </svg>
                  </div>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
                <p class="text-sm text-gray-500 leading-relaxed">{step.description}</p>
              </div>
            </div>

            <!-- Center dot (desktop) -->
            <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2 w-5 h-5 rounded-full bg-ccesz-header ring-4 ring-orange-50 z-10" aria-hidden="true"></div>

            <!-- Spacer -->
            <div class="hidden lg:block w-[calc(50%-2.5rem)]"></div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  gsap.fromTo(".proceso-header",
    { opacity: 0, y: 20 },
    { opacity: 1, y: 0, duration: 0.7, ease: "power3.out",
      scrollTrigger: { trigger: "#proceso-section", start: "top 80%", toggleActions: "play none none none" } }
  )

  document.querySelectorAll<HTMLElement>(".proceso-step").forEach((step, i) => {
    gsap.fromTo(step,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 0.6, ease: "power3.out",
        scrollTrigger: { trigger: step, start: "top 85%", toggleActions: "play none none none" },
        delay: i * 0.05 }
    )
  })
</script>
