---
import { Image } from "astro:assets"
import heroImage from "../../../assets/hero3.webp"
import { institution } from "@config/institution"

const waMessage = encodeURIComponent("Hola, me gustaría obtener información sobre el proceso de inscripción y matrícula para el próximo año escolar.")
---

<header
  class="relative isolate overflow-hidden py-24 md:py-32 lg:py-40"
  aria-labelledby="inscripciones-hero-heading"
>
  <div class="absolute inset-0">
    <Image
      src={heroImage}
      alt="Campus del Colegio Campestre Exploradores del Saber en Zipaquirá — entorno natural para el aprendizaje"
      title="Campus del Colegio Campestre Exploradores del Saber en Zipaquirá — entorno natural para el aprendizaje"
      width={1920}
      height={1080}
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[50%_40%]"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/55 to-black/70" aria-hidden="true"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <p class="ins-hero-eyebrow text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-orange-400/90 mb-4 opacity-0">
      Cupos disponibles
    </p>
    <h1
      id="inscripciones-hero-heading"
      class="ins-hero-heading text-4xl sm:text-5xl md:text-6xl font-bold text-white opacity-0"
    >
      Inscripciones y Admisiones
    </h1>
    <p class="ins-hero-sub mt-4 text-lg md:text-xl text-white/85 max-w-2xl mx-auto opacity-0">
      Abre las puertas al aprendizaje en un entorno campestre único. Conoce el proceso de admisión y asegura el cupo de tu hijo en el Colegio Exploradores del Saber.
    </p>

    <div class="ins-hero-actions mt-10 flex flex-col sm:flex-row justify-center items-center gap-3 opacity-0">
      <a
        href={`https://wa.me/${institution.phone}?text=${waMessage}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Solicitar información por WhatsApp"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-green-500 px-7 py-3.5 text-sm font-semibold text-white hover:bg-green-400 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-green-400/50"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Solicitar información
      </a>
      <a
        href={`tel:+${institution.phone}`}
        title="Llamar al colegio"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-white/40 bg-white/10 backdrop-blur-sm px-7 py-3.5 text-sm font-semibold text-white hover:bg-white/20 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-white/30"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
        </svg>
        {institution.phoneLabel}
      </a>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap"

  const tl = gsap.timeline({ defaults: { ease: "power3.out" } })
  tl.fromTo(".ins-hero-eyebrow",  { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 })
    .fromTo(".ins-hero-heading",  { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8 }, "-=0.3")
    .fromTo(".ins-hero-sub",      { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.7 }, "-=0.4")
    .fromTo(".ins-hero-actions",  { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6 }, "-=0.3")
</script>
