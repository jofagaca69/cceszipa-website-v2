---
import { Icon } from 'astro-icon/components'

const features = [
  {
    number: "01",
    icon: "mdi:lightbulb-outline",
    label: "Educación holística",
    description:
      "Integramos el desarrollo académico, emocional y social en cada etapa formativa, promoviendo el pensamiento crítico, la creatividad y los valores que forman estudiantes íntegros.",
  },
  {
    number: "02",
    icon: "mdi:account-group-outline",
    label: "Clases reducidas",
    description:
      "Nuestros grupos pequeños permiten una atención personalizada y un seguimiento cercano del progreso de cada estudiante a lo largo del año.",
  },
  {
    number: "03",
    icon: "mdi:home-heart",
    label: "Enfoque familiar",
    description:
      "Trabajamos de la mano con las familias, fomentando una comunicación abierta y constante que fortalece el proceso educativo dentro y fuera del aula.",
  },
  {
    number: "04",
    icon: "mdi:leaf",
    label: "Ambiente seguro y natural",
    description:
      "Un entorno campestre en Zipaquirá que favorece el aprendizaje en contacto con la naturaleza, diseñado para el bienestar y la tranquilidad de nuestros estudiantes.",
  },
]
---

<section
  class="w-screen max-w-none relative left-1/2 -translate-x-1/2 bg-[#FAF7EF] py-16 md:py-24"
  aria-labelledby="features-heading"
  id="features-section"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Heading: left on desktop, centered on mobile -->
    <div class="mb-12 md:mb-16 max-w-2xl">
      <h2
        id="features-heading"
        class="features-heading text-gray-900 text-3xl sm:text-4xl md:text-[2.6rem] font-bold tracking-tight leading-[1.1] opacity-0"
      >
        Aprendizaje, acompañamiento y desarrollo
      </h2>
      <p class="features-sub mt-4 text-base sm:text-lg text-gray-500 leading-relaxed opacity-0">
        Todo lo que hacemos parte de la misma convicción: cada estudiante merece una educación que lo vea como persona, no como número.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {features.map((feature, index) => (
        <article
          class={`feature-card feature-card-${index} bg-white border border-gray-200 rounded-xl p-6 flex flex-col gap-5 opacity-0`}
        >
          <!-- Number + icon row -->
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold tracking-[0.18em] text-gray-300 select-none">
              {feature.number}
            </span>
            <Icon name={feature.icon} class="w-5 h-5 text-ccesz-header" />
          </div>

          <!-- Label -->
          <h3 class="text-base font-semibold text-gray-900 leading-snug">
            {feature.label}
          </h3>

          <!-- Description -->
          <p class="text-sm text-gray-500 leading-relaxed flex-1">
            {feature.description}
          </p>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const trigger = { trigger: "#features-section", start: "top 78%", toggleActions: "play none none none" }

  gsap.fromTo(".features-heading", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", scrollTrigger: trigger })
  gsap.fromTo(".features-sub",     { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", delay: 0.1, scrollTrigger: trigger })

  gsap.fromTo(
    ".feature-card",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: "power3.out", delay: 0.15, scrollTrigger: trigger }
  )

  document.querySelectorAll(".feature-card").forEach(card => {
    card.addEventListener("mouseenter", () =>
      gsap.to(card, { borderColor: "#f86c05", duration: 0.2, ease: "power2.out" })
    )
    card.addEventListener("mouseleave", () =>
      gsap.to(card, { borderColor: "#e5e7eb", duration: 0.2, ease: "power2.out" })
    )
  })
</script>
