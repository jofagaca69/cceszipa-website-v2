---
import { Icon } from 'astro-icon/components'
import { institution } from "@config/institution"
---

<section
  class="w-screen max-w-none relative left-1/2 -translate-x-1/2 bg-[#FAF7EF] py-16 md:py-24"
  aria-labelledby="location-heading"
  id="location-section"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- Info -->
      <div>
        <p class="location-eyebrow text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-orange-600/70 mb-4 opacity-0">
          ¿Cómo llegar?
        </p>

        <h2
          id="location-heading"
          class="location-heading text-gray-900 text-3xl sm:text-4xl md:text-[2.6rem] font-bold tracking-tight leading-[1.1] opacity-0"
        >
          Ubicados en Zipaquirá, en un entorno natural y campestre
        </h2>

        <p class="location-sub mt-4 text-base sm:text-lg text-gray-500 leading-relaxed opacity-0">
          A pocos minutos de Zipaquirá, nuestro campus campestre ofrece un ambiente tranquilo y seguro rodeado de naturaleza.
        </p>

        <!-- Info cards -->
        <div class="location-cards mt-8 flex flex-col gap-4 opacity-0">

          <div class="flex items-start gap-4 bg-white border border-gray-200 rounded-xl p-4">
            <span class="flex-shrink-0 mt-0.5 w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center">
              <Icon name="mdi:map-marker-outline" class="w-5 h-5 text-ccesz-header" />
            </span>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-gray-400 mb-1">Dirección</p>
              {institution.address.map(line => (
                <p class="text-sm font-medium text-gray-700">{line}</p>
              ))}
              <p class="text-sm text-gray-500">{institution.city}, Colombia</p>
            </div>
          </div>

          <div class="flex items-start gap-4 bg-white border border-gray-200 rounded-xl p-4">
            <span class="flex-shrink-0 mt-0.5 w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center">
              <Icon name="mdi:phone-outline" class="w-5 h-5 text-ccesz-header" />
            </span>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-gray-400 mb-1">Teléfono</p>
              <a
                href={`tel:+${institution.phone}`}
                title="Llamar al colegio"
                class="text-sm font-medium text-gray-700 hover:text-ccesz-header transition-colors"
              >
                {institution.phoneLabel}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4 bg-white border border-gray-200 rounded-xl p-4">
            <span class="flex-shrink-0 mt-0.5 w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center">
              <Icon name="mdi:email-outline" class="w-5 h-5 text-ccesz-header" />
            </span>
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-gray-400 mb-1">Correo electrónico</p>
              <a
                href={`mailto:${institution.email}`}
                title="Enviar correo al colegio"
                class="text-sm font-medium text-gray-700 hover:text-ccesz-header transition-colors break-all"
              >
                {institution.email}
              </a>
            </div>
          </div>

        </div>

        <a
          href="https://maps.app.goo.gl/3YkqKFrv2nAttDM67"
          target="_blank"
          rel="noopener noreferrer"
          title="Abrir ubicación en Google Maps"
          class="location-cta mt-6 inline-flex items-center gap-2 rounded-full bg-gray-900 px-7 py-3.5 text-sm font-semibold text-white hover:bg-gray-700 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-400/50 opacity-0"
        >
          <Icon name="mdi:map-marker" class="w-4 h-4" />
          Abrir en Google Maps
        </a>
      </div>

      <!-- Map -->
      <div class="location-map rounded-2xl overflow-hidden border border-gray-200 shadow-sm opacity-0 aspect-[4/3] lg:aspect-auto lg:h-[480px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3974.4198454237294!2d-73.96740912323757!3d5.0354663949411185!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e406e3ca3a648d1%3A0x6dbdedfa4c8316e5!2sColegio%20Campestre%20Exploradores%20Del%20Saber%20Zipaquir%C3%A1!5e0!3m2!1ses!2sco!4v1774293294782!5m2!1ses!2sco"
          class="w-full h-full"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación del Colegio Campestre Exploradores del Saber en Zipaquirá"
        ></iframe>
      </div>

    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const trigger = { trigger: "#location-section", start: "top 78%", toggleActions: "play none none none" }

  gsap.fromTo(".location-eyebrow", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", scrollTrigger: trigger })
  gsap.fromTo(".location-heading", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", delay: 0.08, scrollTrigger: trigger })
  gsap.fromTo(".location-sub",     { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", delay: 0.16, scrollTrigger: trigger })
  gsap.fromTo(".location-cards",   { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", delay: 0.24, scrollTrigger: trigger })
  gsap.fromTo(".location-cta",     { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: "power3.out", delay: 0.32, scrollTrigger: trigger })
  gsap.fromTo(".location-map",     { opacity: 0, x: 24 }, { opacity: 1, x: 0, duration: 0.9, ease: "power3.out", delay: 0.2,  scrollTrigger: trigger })
</script>
