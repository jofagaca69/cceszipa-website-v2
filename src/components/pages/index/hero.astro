---
import { Image } from "astro:assets"
import { Icon } from "astro-icon/components"
import heroImage from "../../../assets/hero.jpg"
import star from "../../../assets/signs.png"
import { institution } from "@config/institution"

const currentYear = new Date().getFullYear()
const waMessage = encodeURIComponent(`Hola, me gustaría recibir información sobre el colegio y el proceso de admisiones ${currentYear}.`)
---

<section
  class="relative isolate overflow-hidden bg-[#fff7e8] min-h-screen lg:min-h-[110vh]"
  aria-labelledby="hero-main-heading"
  id="hero-section"
>

  <div class="relative z-20 w-full pt-16 sm:pt-24 lg:pt-32 pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8">

    <!-- Contenido centrado -->
    <div class="mx-auto max-w-3xl text-center">

      <!-- Ubicación -->
      <p class="hero-location text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase font-extrabold text-orange-600/70 mb-5 opacity-0">
        {institution.city} · {institution.country}
      </p>

      <!-- Título principal -->
      <div class="relative hero-title opacity-0">
        <h1
          id="hero-main-heading"
          class="bg-ccesz-header rounded-3xl p-12 mb-12"
        >
          <span class="block text-[2.6rem] sm:text-6xl md:text-7xl lg:text-[80px] font-semibold text-white leading-[1.05] tracking-[-0.03em]">
            {institution.name}
          </span>
        </h1>

        <!-- Flotantes mobile: sobre las esquinas del H1 -->
        <div class="lg:hidden pointer-events-none select-none" aria-hidden="true">
          <!-- top-derecha -->
          <div class="float-card float-m1 absolute -top-5 -right-3 sm:-right-5 w-[115px] sm:w-[145px] z-30">
            <Image
              src={heroImage}
              alt=""
              width={290} height={370}
              format="webp" quality={75} loading="eager"
              class="w-full h-full object-cover object-[65%_30%]"
            />
          </div>
          <!-- bottom-izquierda -->
          <div class="float-card float-m2 absolute -bottom-10 -left-3 sm:-left-5 w-[115px] sm:w-[145px] z-30">
            <Image
              src={heroImage}
              alt=""
              width={290} height={290}
              format="webp" quality={75} loading="lazy"
              class="w-full h-full object-cover object-[30%_70%]"
            />
          </div>
        </div>

        <!-- Flotantes desktop: 4 esquinas del H1 -->
        <div class="hidden lg:block pointer-events-none select-none" aria-hidden="true">
          <!-- top-izquierda: retrato -->
          <div class="float-card float-1 absolute -top-10 xl:-top-14 -left-[100px] xl:-left-[160px] w-[190px] xl:w-[230px] z-30">
            <Image
              src={heroImage}
              alt=""
              width={460} height={580}
              format="webp" quality={80} loading="eager"
              class="w-full h-full object-cover object-[40%_20%]"
            />
          </div>
          <!-- top-derecha: apaisado -->
          <div class="float-card float-2 absolute -top-8 xl:-top-12 -right-[100px] xl:-right-[200px] w-[220px] xl:w-[265px] z-30">
            <Image
              src={heroImage}
              alt=""
              width={530} height={350}
              format="webp" quality={80} loading="eager"
              class="w-full h-full object-cover object-[60%_40%]"
            />
          </div>
          <!-- bottom-izquierda: cuadrado -->
          <div class="float-card float-3 absolute -bottom-[200px] xl:-bottom-14 -left-[95px] xl:-left-[125px] w-[175px] xl:w-[215px] z-30">
            <Image
              src={heroImage}
              alt=""
              width={430} height={430}
              format="webp" quality={80} loading="lazy"
              class="w-full h-full object-cover object-[20%_65%]"
            />
          </div>
          <!-- bottom-derecha: retrato -->
          <div class="float-card float-4 absolute -bottom-8 xl:-bottom-12 -right-[95px] xl:-right-[125px] w-[230px] xl:w-[245px] z-30">
            <Image
              src={heroImage}
              alt=""
              width={490} height={610}
              format="webp" quality={80} loading="lazy"
              class="w-full h-full object-cover object-[70%_50%]"
            />
          </div>
        </div>
      </div>

      <!-- Tagline -->
      <p class="hero-tagline mt-4 sm:mt-5 text-xl sm:text-2xl md:text-3xl font-medium text-orange-500 tracking-tight opacity-0">
        Formando exploradores del conocimiento
      </p>

      <!-- Descripción -->
      <p class="hero-description mt-5 sm:mt-6 text-base sm:text-lg text-gray-500 leading-relaxed max-w-xl mx-auto opacity-0">
        Educación integral de excelencia con enfoque en valores, pensamiento crítico y contacto con la naturaleza, en Zipaquirá.
      </p>

      <!-- Badge inscripciones -->
      <div class="hero-badge mt-6 sm:mt-8 flex justify-center opacity-0">
        <span class="inscripciones-tag">
          Inscripciones Abiertas {currentYear}
        </span>
      </div>

      <!-- CTAs -->
      <div class="hero-cta mt-8 sm:mt-10 flex flex-col sm:flex-row justify-center items-center gap-3 opacity-0">
        <a
          href="/formulario"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-gray-900 px-7 py-3.5 text-sm font-semibold text-white hover:bg-gray-700 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-400/50"
        >
          Solicita Información
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>

        <a
          href={`https://wa.me/${institution.phone}?text=${waMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-green-600 px-7 py-3.5 text-sm font-semibold text-white hover:bg-green-500 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-green-400/50"
        >
          <Icon name="mdi:whatsapp" class="w-4 h-4" />
          WhatsApp
        </a>

        <a
          href={`tel:+${institution.phone}`}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 bg-white px-7 py-3.5 text-sm font-semibold text-gray-700 hover:border-gray-400 hover:text-gray-900 transition-colors duration-200 focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-300/50"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {institution.phoneLabel}
        </a>
      </div>
    </div>

    <!-- Imagen del campus — solo tablet (md), flotantes reemplazan en mobile y desktop -->
    <div class="hero-image block mx-auto mt-6 sm:mt-10 max-w-5xl opacity-0">
      <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-[0_20px_80px_-10px_rgba(0,0,0,0.18)] ring-1 ring-black/5">
        <Image
          src={heroImage}
          alt="Campus del Colegio Campestre Exploradores del Saber en Zipaquirá — instalaciones rodeadas de naturaleza"
          width={1920}
          height={1080}
          format="webp"
          quality={88}
          loading="eager"
          fetchpriority="high"
          class="w-full h-[260px] sm:h-[400px] md:h-[520px] object-cover"
        />
        <!-- Gradient inferior para transición suave -->
        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/30 to-transparent pointer-events-none" aria-hidden="true"></div>

        <!-- Etiqueta flotante sobre la imagen -->
        <div class="absolute bottom-5 left-5 sm:bottom-8 sm:left-8">
          <span class="inline-flex items-center gap-2 rounded-xl bg-white/90 backdrop-blur-sm px-3 py-2 text-xs sm:text-sm font-semibold text-gray-800 shadow-sm border border-white/60">
            <svg class="w-3.5 h-3.5 text-orange-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            Km 5 Vía Zipaquirá - Nemocón · Vereda La Granja
          </span>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="hero-stats mx-auto mt-8 sm:mt-10 max-w-3xl grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 opacity-0">
      <div class="stat-card text-center bg-white rounded-2xl p-4 sm:p-5 border border-gray-100 shadow-sm">
        <p class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">15+</p>
        <p class="mt-1 text-xs sm:text-sm text-gray-500">Años de Experiencia</p>
      </div>
      <div class="stat-card text-center bg-white rounded-2xl p-4 sm:p-5 border border-gray-100 shadow-sm">
        <p class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">+300</p>
        <p class="mt-1 text-xs sm:text-sm text-gray-500">Familias Confían</p>
      </div>
      <div class="stat-card text-center bg-white rounded-2xl p-4 sm:p-5 border border-gray-100 shadow-sm">
        <p class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">3</p>
        <p class="mt-1 text-xs sm:text-sm text-gray-500">Niveles Educativos</p>
      </div>
      <div class="stat-card text-center bg-white rounded-2xl p-4 sm:p-5 border border-gray-100 shadow-sm">
        <p class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">100%</p>
        <p class="mt-1 text-xs sm:text-sm text-gray-500">Formación Integral</p>
      </div>
    </div>

  </div>
</section>

<!-- Barra de valores con bordes ondulados -->
<div class="relative -mt-[1px]">
  <div class="absolute top-0 left-0 w-full h-6 sm:h-8 -translate-y-full overflow-visible pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full block" viewBox="0 0 1000 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,50 Q12.5,75 25,50 Q37.5,25 50,50 Q62.5,75 75,50 Q87.5,25 100,50 Q112.5,75 125,50 Q137.5,25 150,50 Q162.5,75 175,50 Q187.5,25 200,50 Q212.5,75 225,50 Q237.5,25 250,50 Q262.5,75 275,50 Q287.5,25 300,50 Q312.5,75 325,50 Q337.5,25 350,50 Q362.5,75 375,50 Q387.5,25 400,50 Q412.5,75 425,50 Q437.5,25 450,50 Q462.5,75 475,50 Q487.5,25 500,50 Q512.5,75 525,50 Q537.5,25 550,50 Q562.5,75 575,50 Q587.5,25 600,50 Q612.5,75 625,50 Q637.5,25 650,50 Q662.5,75 675,50 Q687.5,25 700,50 Q712.5,75 725,50 Q737.5,25 750,50 Q762.5,75 775,50 Q787.5,25 800,50 Q812.5,75 825,50 Q837.5,25 850,50 Q862.5,75 875,50 Q887.5,25 900,50 Q912.5,75 925,50 Q937.5,25 950,50 Q962.5,75 975,50 Q987.5,25 1000,50 L1000,100 L0,100 Z" fill="#f86c05"/>
    </svg>
  </div>

  <section class="relative bg-ccesz-header py-2 sm:py-3 overflow-hidden" aria-label="Valores institucionales">
    <div class="values-marquee-wrapper">
      <div class="values-marquee flex items-center gap-4 sm:gap-8">
        <h3 class="text-[#FFF7E8] font-bold text-sm sm:text-base whitespace-nowrap">RESPETO, PACIENCIA Y SABIDURÍA</h3>
        <Image src={star} alt="" class="w-4 h-4 sm:w-auto sm:h-auto" aria-hidden="true" />
        <h3 class="text-[#FFF7E8] font-bold text-sm sm:text-base whitespace-nowrap">RESPETO, PACIENCIA Y SABIDURÍA</h3>
        <Image src={star} alt="" class="w-4 h-4 sm:w-auto sm:h-auto" aria-hidden="true" />
        <h3 class="text-[#FFF7E8] font-bold text-sm sm:text-base whitespace-nowrap">RESPETO, PACIENCIA Y SABIDURÍA</h3>
        <Image src={star} alt="" class="w-4 h-4 sm:w-auto sm:h-auto" aria-hidden="true" />
        <h3 class="text-[#FFF7E8] font-bold text-sm sm:text-base whitespace-nowrap">RESPETO, PACIENCIA Y SABIDURÍA</h3>
        <Image src={star} alt="" class="w-4 h-4 sm:w-auto sm:h-auto" aria-hidden="true" />
      </div>
    </div>
  </section>

  <div class="absolute bottom-0 left-0 w-full h-6 sm:h-8 translate-y-full overflow-visible pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full block scale-y-[-1]" viewBox="0 0 1000 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,50 Q12.5,75 25,50 Q37.5,25 50,50 Q62.5,75 75,50 Q87.5,25 100,50 Q112.5,75 125,50 Q137.5,25 150,50 Q162.5,75 175,50 Q187.5,25 200,50 Q212.5,75 225,50 Q237.5,25 250,50 Q262.5,75 275,50 Q287.5,25 300,50 Q312.5,75 325,50 Q337.5,25 350,50 Q362.5,75 375,50 Q387.5,25 400,50 Q412.5,75 425,50 Q437.5,25 450,50 Q462.5,75 475,50 Q487.5,25 500,50 Q512.5,75 525,50 Q537.5,25 550,50 Q562.5,75 575,50 Q587.5,25 600,50 Q612.5,75 625,50 Q637.5,25 650,50 Q662.5,75 675,50 Q687.5,25 700,50 Q712.5,75 725,50 Q737.5,25 750,50 Q762.5,75 775,50 Q787.5,25 800,50 Q812.5,75 825,50 Q837.5,25 850,50 Q862.5,75 875,50 Q887.5,25 900,50 Q912.5,75 925,50 Q937.5,25 950,50 Q962.5,75 975,50 Q987.5,25 1000,50 L1000,100 L0,100 Z" fill="#f86c05"/>
    </svg>
  </div>
</div>

<style>
  .inscripciones-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a3412;
    background-color: #ffedd5;
    border-bottom: 2px solid #f97316;
    padding: 0.35rem 0.75rem 0.3rem;
    border-radius: 2px;
  }

  /* Tarjetas flotantes */
  .float-card {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 30px -4px rgba(0,0,0,0.15), 0 2px 8px -2px rgba(0,0,0,0.08);
    outline: 1px solid rgba(0,0,0,0.06);
    will-change: transform;
  }

  /* Mobile — z-index elevado para superponer al H1 */
  .float-m1 { transform: rotate(6deg);  }
  .float-m2 { transform: rotate(-5deg); }

  /* El wrapper del H1 no debe cortar los hijos que sobresalen */
  .hero-title { overflow: visible; }

  /* Desktop */
  .float-1 { transform: rotate(-4deg); }
  .float-2 { transform: rotate(5deg);  }
  .float-3 { transform: rotate(-7deg); }
  .float-4 { transform: rotate(4deg);  }
</style>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const isDesktop = () => window.innerWidth >= 1024

  // ── Entry: contenido ──────────────────────────────────────────
  const tl = gsap.timeline({ defaults: { ease: "power3.out" } })

  tl.to(".hero-location",   { opacity: 1, y: 0, duration: 0.7, delay: 0.1 })
    .to(".hero-title",       { opacity: 1, y: 0, duration: 0.9 }, "-=0.4")
    .to(".hero-tagline",     { opacity: 1, y: 0, duration: 0.8 }, "-=0.6")
    .to(".hero-description", { opacity: 1, y: 0, duration: 0.7 }, "-=0.5")
    .to(".hero-badge",       { opacity: 1, y: 0, duration: 0.6 }, "-=0.5")
    .to(".hero-cta",         { opacity: 1, y: 0, duration: 0.7 }, "-=0.4")
    .to(".hero-image",       { opacity: 1, y: 0, duration: 1.0 }, "-=0.3")
    .to(".hero-stats",       { opacity: 1, y: 0, duration: 0.7 }, "-=0.5")

  // ── Entry + levitación: flotantes mobile ─────────────────────
  if (!isDesktop()) {
    gsap.set([".float-m1", ".float-m2"], { opacity: 0 })
    gsap.from(".float-m1", { x: 40, opacity: 0, duration: 0.9, delay: 0.7, ease: "power3.out" })
    gsap.from(".float-m2", { x: -40, opacity: 0, duration: 0.9, delay: 1.0, ease: "power3.out" })
    gsap.to(".float-m1", { opacity: 1, duration: 0.9, delay: 0.7, ease: "power3.out" })
    gsap.to(".float-m2", { opacity: 1, duration: 0.9, delay: 1.0, ease: "power3.out" })
    gsap.to(".float-m1", { y: -10, duration: 3.0, ease: "sine.inOut", yoyo: true, repeat: -1, delay: 1.6 })
    gsap.to(".float-m2", { y:  -8, duration: 2.7, ease: "sine.inOut", yoyo: true, repeat: -1, delay: 2.0 })
  }

  // ── Entry: imágenes flotantes (desktop) ───────────────────────
  if (isDesktop()) {
    gsap.set([".float-1",".float-2",".float-3",".float-4"], { opacity: 0 })

    gsap.to(".float-1", { opacity: 1, x: 0, duration: 0.9, delay: 0.6,  ease: "power3.out", clearProps: "x" })
    gsap.to(".float-2", { opacity: 1, x: 0, duration: 0.9, delay: 0.85, ease: "power3.out", clearProps: "x" })
    gsap.to(".float-3", { opacity: 1, x: 0, duration: 0.9, delay: 1.1,  ease: "power3.out", clearProps: "x" })
    gsap.to(".float-4", { opacity: 1, x: 0, duration: 0.9, delay: 1.3,  ease: "power3.out", clearProps: "x" })

    // Posición inicial fuera de pantalla (de los lados)
    gsap.from(".float-1", { x: -60, duration: 0.9, delay: 0.6,  ease: "power3.out" })
    gsap.from(".float-2", { x:  60, duration: 0.9, delay: 0.85, ease: "power3.out" })
    gsap.from(".float-3", { x: -50, duration: 0.9, delay: 1.1,  ease: "power3.out" })
    gsap.from(".float-4", { x:  50, duration: 0.9, delay: 1.3,  ease: "power3.out" })

    // ── Levitación continua (fases distintas) ─────────────────
    gsap.to(".float-1", { y: -12, duration: 3.2, ease: "sine.inOut", yoyo: true, repeat: -1 })
    gsap.to(".float-2", { y:  -9, duration: 2.8, ease: "sine.inOut", yoyo: true, repeat: -1, delay: 0.6 })
    gsap.to(".float-3", { y: -14, duration: 3.6, ease: "sine.inOut", yoyo: true, repeat: -1, delay: 1.1 })
    gsap.to(".float-4", { y:  -8, duration: 2.5, ease: "sine.inOut", yoyo: true, repeat: -1, delay: 0.3 })

    // ── Parallax en scroll (velocidades distintas por card) ───
    const scrollCfg = { trigger: "#hero-section", start: "top top", end: "bottom top", scrub: 1 }
    gsap.to(".float-1", { yPercent: -18, ease: "none", scrollTrigger: scrollCfg })
    gsap.to(".float-2", { yPercent: -28, ease: "none", scrollTrigger: scrollCfg })
    gsap.to(".float-3", { yPercent: -12, ease: "none", scrollTrigger: scrollCfg })
    gsap.to(".float-4", { yPercent: -22, ease: "none", scrollTrigger: scrollCfg })
  }

  // ── Parallax campus card (mobile/tablet) ──────────────────────
  gsap.to(".hero-image", {
    yPercent: 5,
    ease: "none",
    scrollTrigger: { trigger: "#hero-section", start: "top top", end: "bottom top", scrub: true }
  })

  // ── Hover en stat cards ───────────────────────────────────────
  document.querySelectorAll(".stat-card").forEach(card => {
    card.addEventListener("mouseenter", () =>
      gsap.to(card, { y: -3, duration: 0.2, ease: "power2.out" })
    )
    card.addEventListener("mouseleave", () =>
      gsap.to(card, { y:  0, duration: 0.2, ease: "power2.out" })
    )
  })

  // ── Valores marquee infinito ──────────────────────────────────
  const marquee = document.querySelector(".values-marquee")
  if (marquee) {
    marquee.innerHTML += marquee.innerHTML
    const w = (marquee as HTMLElement).scrollWidth / 2
    gsap.to(".values-marquee", { x: -w, duration: 40, ease: "none", repeat: -1 })
  }
</script>
