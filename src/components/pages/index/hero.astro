---
import { Image } from "astro:assets"
import heroImage from "../../../assets/hero.jpg"
import star from "../../../assets/signs.png"
---

<section
  class="relative isolate overflow-hidden"
  aria-labelledby="hero-main-heading"
>

  <!-- Imagen -->
  <div class="relative h-[65vh] min-h-[480px] w-full">
    <Image
      src={heroImage}
      alt="Estudiantes del Colegio Campestre Exploradores del Saber en Zipaquirá durante una actividad académica al aire libre"
      width={1920}
      height={1080}
      formats={["avif", "webp"]}
      quality={85}
      loading="eager"
      fetchpriority="high"
      class="hero-image h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/25" aria-hidden="true"></div>
  </div>

  <!-- Contenido -->
  <div class="relative z-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <div
        id="hero-card"
        class="-mt-24 md:absolute md:bottom-20 md:right-20 md:max-w-xl"
      >
        <div
          class="
      relative
      rounded-3xl
      bg-[#EFE3A2]
      p-8
      shadow-[0_25px_60px_-15px_rgba(0,0,0,0.35)]
      border border-white/30
      overflow-hidden
    "
        >

          <!-- Glow decorativo -->
          <div
            aria-hidden="true"
            class="
        pointer-events-none
        absolute -top-20 -right-20
        h-64 w-64
        rounded-full
        bg-orange-400/30
        blur-3xl
      "
          ></div>

          <!-- Contenido -->
          <div class="relative">

            <h1
              id="hero-main-heading"
              class="text-lg sm:text-xl font-semibold text-gray-900"
            >
              Colegio Campestre Exploradores del Saber – Zipaquirá
            </h1>

            <h2
              class="hero-title mt-2 text-2xl sm:text-3xl md:text-4xl font-bold leading-tight text-orange-600"
            >
              Formando a los exploradores del conocimiento para el futuro
            </h2>

            <p class="hero-text mt-4 text-gray-800 text-sm sm:text-base leading-relaxed">
              Educación integral con enfoque holístico en un entorno seguro,
              natural y orientado al desarrollo académico y humano.
            </p>

            <div class="mt-6">
              <a
                href="/formulario"
                class="
            hero-btn
            inline-flex items-center justify-center
            rounded-full
            bg-orange-600
            px-6 py-3
            text-sm sm:text-base
            font-semibold
            text-white
            shadow-lg
            hover:bg-orange-700
            hover:shadow-xl
            transition-all
            duration-300
            focus:outline-none
            focus-visible:ring-2
            focus-visible:ring-orange-600
            focus-visible:ring-offset-2
          "
              >
                Solicita información
              </a>
            </div>

          </div>
        </div>
      </div>


    </div>
  </div>

</section>

<section class="relative bg-ccesz-header py-3 flex justify-center items-center gap-6" aria-labelledby="hero-main-heading">
  <h3 class="text-[#FFF7E8] font-bold hidden lg:block">RESPETO, PACIENCIA Y SABIDURÍA</h3>
  <Image src={star} alt="Star separator hidden lg:block"></Image>

  <h3 class="text-[#FFF7E8] font-bold">RESPETO, PACIENCIA Y SABIDURÍA</h3>
  <Image src={star} alt="Star separator "></Image>

  <h3 class="text-[#FFF7E8] font-bold hidden lg:block">RESPETO, PACIENCIA Y SABIDURÍA</h3>
</section>
