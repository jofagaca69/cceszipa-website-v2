---
const testimonials = [
  {
    quote: "Desde que mi hijo entró al colegio, su confianza y amor por aprender cambiaron por completo. Los profesores lo conocen por su nombre y saben exactamente cómo motivarlo.",
    name: "Laura Rodríguez",
    role: "Mamá de estudiante de Primaria",
  },
  {
    quote: "Lo que más nos convenció fue el entorno campestre y los grupos pequeños. Sentimos que nuestros hijos son acompañados de verdad, no solo instruidos.",
    name: "Carlos y Jimena Gómez",
    role: "Padres de familia · Preescolar",
  },
  {
    quote: "El compromiso del colegio con las familias es real. Siempre hay comunicación abierta, y eso para nosotros como padres es lo más importante.",
    name: "Marcela Vásquez",
    role: "Mamá de estudiante de Primaria",
  },
]
---

<section
  class="w-screen max-w-none relative left-1/2 -translate-x-1/2 bg-white py-16 md:py-24"
  aria-labelledby="testimonials-heading"
  id="testimonials-section"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Heading -->
    <div class="mb-12 md:mb-16 max-w-xl">
      <h2
        id="testimonials-heading"
        class="testimonials-heading text-gray-900 text-3xl sm:text-4xl md:text-[2.6rem] font-bold tracking-tight leading-[1.1] opacity-0"
      >
        Lo que dicen las familias
      </h2>
      <p class="testimonials-sub mt-4 text-base sm:text-lg text-gray-500 leading-relaxed opacity-0">
        La confianza de más de 300 familias es el mejor reflejo de nuestro trabajo.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
      {testimonials.map((t, index) => (
        <blockquote
          class={`testimonial-card testimonial-card-${index} bg-[#FAF7EF] border border-gray-200 rounded-xl p-6 md:p-7 flex flex-col gap-5 opacity-0`}
        >
          <!-- Quote mark -->
          <span class="text-4xl font-serif text-ccesz-header/30 leading-none select-none" aria-hidden="true">"</span>

          <!-- Quote text -->
          <p class="text-gray-700 text-sm sm:text-base leading-relaxed flex-1">
            {t.quote}
          </p>

          <!-- Author -->
          <footer class="pt-4 border-t border-gray-200">
            <p class="text-sm font-semibold text-gray-900">{t.name}</p>
            <p class="text-xs text-gray-400 mt-0.5">{t.role}</p>
          </footer>
        </blockquote>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const trigger = { trigger: "#testimonials-section", start: "top 78%", toggleActions: "play none none none" }

  gsap.fromTo(".testimonials-heading", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", scrollTrigger: trigger })
  gsap.fromTo(".testimonials-sub",     { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out", delay: 0.1, scrollTrigger: trigger })

  gsap.fromTo(
    ".testimonial-card",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: "power3.out", delay: 0.15, scrollTrigger: trigger }
  )
</script>