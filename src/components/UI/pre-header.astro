---
import { Icon } from 'astro-icon/components';
import { institution } from '@config/institution';

const {phone, phoneLabel} = institution;
---

<div class="bg-[#fff7e7] text-ccesz-primary text-sm">
  <div class="mx-auto max-w-7xl px-4 py-2 lg:py-1">

    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">

      <!-- Mensaje principal -->
      <p class="flex items-center justify-center md:justify-start gap-2 font-medium text-center md:text-left">
        <span>
          ¡Inscripciones abiertas 2026!
        </span>

      </p>

      <!-- Contacto + CTA -->
      <div class="flex flex-wrap items-center justify-center gap-4">

        <!-- Teléfono -->
        <a
          href={`https://wa.me/${phone}`}
          class="flex items-center gap-1 font-semibold hover:opacity-90 transition"
          aria-label="Contactar por WhatsApp"
          title="Contactar por WhatsApp"
        >
          <Icon name="mdi:call" class="text-xl"/> {phoneLabel}
        </a>

        <!-- CTA -->
        <a
          href="/admisiones"
          title="Iniciar proceso de Admisiones 2026"
          class="rounded-md bg-[#fff7e7] text-ccesz-primary border-2 border-ccesz-primary px-3 py-1.5 font-semibold hover:bg-gray-100 transition"
        >
          Admisiones 2026
        </a>

      </div>

    </div>

  </div>
</div>
